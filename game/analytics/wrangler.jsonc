{
  "name": "uo7-playtime",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "observability": { "enabled": false },
  "analytics_engine_datasets": [{ "binding": "PLAYTIME", "dataset": "uo7_dataset" }],
  "ratelimits": [{ "name": "INGEST_LIMIT", "namespace_id": "7001", "simple": { "limit": 60, "period": 60 } }],
  "routes": [{ "pattern": "telemetry.ultimaoffline7.com", "custom_domain": true }]
}
